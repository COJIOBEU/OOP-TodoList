<Window x:Class="TodoList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Todo List" Height="550" Width="850"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="TasksListBox" Grid.Column="0" Margin="0,0,10,0" FontSize="14"
                 SelectionChanged="TasksListBox_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,5">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <TextBlock Text="Название задачи:" FontWeight="Bold"/>
            <TextBox x:Name="TitleTextBox" Height="30" Margin="0,5,0,15"/>

            <TextBlock Text="Описание:" FontWeight="Bold"/>
            <TextBox x:Name="DescriptionTextBox" Height="60" TextWrapping="Wrap" 
                     AcceptsReturn="True" Margin="0,5,0,15"/>

            <TextBlock Text="Срок выполнения:" FontWeight="Bold"/>
            <DatePicker x:Name="DueDatePicker" Margin="0,5,0,15"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Приоритет:" FontWeight="Bold"/>
                    <ComboBox x:Name="PriorityComboBox" Height="30" Margin="0,5,0,0">
                        <ComboBoxItem Content="Низкий"/>
                        <ComboBoxItem Content="Средний" IsSelected="True"/>
                        <ComboBoxItem Content="Высокий"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Статус:" FontWeight="Bold"/>
                    <ComboBox x:Name="StatusComboBox" Height="30" Margin="0,5,0,0" SelectionChanged="StatusComboBox_SelectionChanged">
                        <ComboBoxItem Content="Не начата" IsSelected="True"/>
                        <ComboBoxItem Content="В процессе"/>
                        <ComboBoxItem Content="Выполнена"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" RenderTransformOrigin="0.5,0.5" Width="392">
                <Button Content="Добавить" Width="120" Height="35" Margin="5" 
                        Click="AddButton_Click"/>
                <Button Content="Обновить" Width="120" Height="35" Margin="5" 
                        Click="UpdateButton_Click"/>
                <Button Content="Удалить" Width="120" Height="35" Margin="5" 
                        Click="DeleteButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>